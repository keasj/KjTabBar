<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>KjTabBar</RootNamespace>

    <AssemblyName>KjTabBar</AssemblyName>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\app_icon.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\app_icon.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <!-- Isolate only markup compilation; setup output discovery needs the normal intermediate path. -->
  <Target Name="IsolateDesignTimeMarkupOutput" BeforeTargets="MarkupCompilePass1" Condition="'$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <_NormalMarkupOutputPath>$(IntermediateOutputPath)</_NormalMarkupOutputPath>
      <IntermediateOutputPath>$(IntermediateOutputPath)DesignTime\</IntermediateOutputPath>
    </PropertyGroup>
  </Target>
  <Target Name="RestoreDesignTimeMarkupOutput" AfterTargets="MarkupCompilePass1" Condition="'$(DesignTimeBuild)' == 'true'">
    <PropertyGroup>
      <IntermediateOutputPath>$(_NormalMarkupOutputPath)</IntermediateOutputPath>
    </PropertyGroup>
  </Target>
</Project>
