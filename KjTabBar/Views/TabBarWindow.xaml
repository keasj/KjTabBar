<Window x:Class="KjTabBar.Views.TabBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KjTabBar.ViewModels"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowDrop="True"
        Background="Transparent"
        AllowsTransparency="True"
        SizeToContent="Height"
        Width="800"
        FontFamily="{Binding FontFamily}"
        FontSize="{Binding FontSize}"
        FontWeight="{Binding FontWeight}"
        FontStyle="{Binding FontStyle}"
        Icon="pack://application:,,,/KjTabBar;component/Assets/Icons/app_icon.png"
        Visibility="{Binding WindowVisibility, Mode=TwoWay}">

    <Window.Resources>
        <Style x:Key="TabToolTipStyle" TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeFgNormal}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <Style x:Key="TabCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeFgSubtle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                            <TextBlock Text="×" FontSize="10" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeCloseHoverBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddTabBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeFgSubtle}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <TextBlock Text="+" FontSize="15" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeTabHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeFgNormal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AbsorbDropZoneStyle" TargetType="Border">
            <Setter Property="Width" Value="87"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="8,2,4,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLine}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeWindowBg}"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                    <Setter Property="Background" Value="{DynamicResource ThemeTabHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Background="{DynamicResource ThemeWindowBg}"
            BorderBrush="{DynamicResource ThemeBorderLine}"
            BorderThickness="1,1,1,0"
            CornerRadius="12,12,0,0"
            Padding="4"
            MouseRightButtonUp="Border_MouseRightButtonUp"
            PreviewMouseWheel="TabBarWindow_PreviewMouseWheel">
        <Grid Margin="6,5,6,7" MinHeight="38">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl x:Name="TabItemsControl" Grid.Column="0" Focusable="False" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type vm:TabItemViewModel}">
                        <Border x:Name="TabBorder" CornerRadius="10,10,0,0" Padding="14,8,8,8" MinWidth="96" MaxWidth="500" Cursor="Hand" Background="{DynamicResource ThemeWindowBg}" MouseLeftButtonUp="Tab_Click" PreviewMouseLeftButtonDown="Tab_MouseLeftButtonDown" PreviewMouseMove="Tab_MouseMove" MouseRightButtonUp="TabBd_MouseRightButtonUp">
                            <Border.ToolTip>
                                <ToolTip Style="{StaticResource TabToolTipStyle}" Content="{Binding Path}" />
                            </Border.ToolTip>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="3,2,3,0"/>
                                    <Setter Property="BorderThickness" Value="1,1,1,0"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLine}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ThemeTabHover}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource ThemeActiveTabBorder}"/>
                                            <Setter Property="BorderThickness" Value="2,2,2,0"/>
                                            <Setter Property="Margin" Value="3,0,3,0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button Style="{StaticResource TabCloseBtn}" Margin="8,0,0,0" Click="CloseTab_Click" DockPanel.Dock="Right" />
                                <Image Source="{Binding IconSource}"
                                       Width="14"
                                       Height="14"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center" />
                                <TextBlock Foreground="{DynamicResource ThemeFgNormal}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.Resources>
            </ItemsControl>
            <Border x:Name="AbsorbDropZone"
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    Style="{StaticResource AbsorbDropZoneStyle}"
                    ToolTip="{DynamicResource AbsorbZoneToolTip}">
                <TextBlock Text="{DynamicResource AbsorbZoneLabel}"
                           Foreground="{DynamicResource ThemeFgSubtle}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Border>
</Window>
